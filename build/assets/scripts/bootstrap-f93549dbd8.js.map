<ng-template #descriptionTooltip><div class="text-left"><p>Description and tags help you organize and search for your ponies.</p><p>Use # tags to be able to quickly find specific ponies like #oc #winter or #unicorn</p><p>Use @ tags to sort your ponies. @top to put them at the start of the list, @end at the end,
and @1 @2 @3 ... to order them manually.</p></div></ng-template><page-loader *ngIf="!playing"></page-loader><div class="row" *ngIf="!playing &amp;&amp; !loading"><div class="col-lg-6 text-center"><h1 class="sr-only" focusTitle>Characters</h1><h2 class="sr-only">Character selection</h2><div class="mx-auto" style="max-width: 400px;"><support-button class="mb-3"></support-button><install-button class="mb-3"></install-button><character-select [(error)]="error" [newButton]="true" [removeButton]="true" (change)="updateMuzzles()" (preview)="previewPony = $event"></character-select><div class="character-preview-box mx-auto my-3" (fixToTop)="fixed = $event" [fixToTopOffset]="-40"><character-preview #characterPreview [pony]="previewInfo" [state]="state" [noBackground]="true" [noShadow]="fixed" [name]="previewName" [tag]="previewTag" [extra]="previewExtra" style="z-index: 100"></character-preview></div><div class="form-group text-center"><button class="btn btn-lg btn-default" [disabled]="!canDuplicate" (click)="duplicate()" aria-label="Duplicate character">Duplicate</button><button class="btn btn-lg btn-default ml-2" [disabled]="!canRevert" (click)="revert()" aria-label="Revert changes">Revert</button><button class="btn btn-lg btn-default ml-2" [disabled]="!canSave" (click)="save()" aria-label="Save character">Save</button></div><play-box label="Save &amp; Play" [(error)]="error"></play-box><play-notice></play-notice></div></div><div class="col-lg-6 character-tabs" [setOutlineHidden]="!customOutlines" [class.character-tab-warning]="updateWarning"><h2 class="sr-only">Character customization</h2><tabset type="pills" *ngIf="loaded" saveActiveTab="character-active-tab" label="Character customization"><tab title="body"><div class="character-tab" *tabContent><div *ngIf="account?.supporter"><div class="row form-group"><label class="col-sm-4 col-form-label text-patreon">Supporter options</label><div class="col-sm-8 text-muted pt-2"><custom-checkbox [(checked)]="pony.hideSupport">hide supporter tag</custom-checkbox></div></div><hr class="my-2"></div><div class="row form-group"><label class="col-sm-4 col-form-label">Advanced options</label><div class="col-sm-8 text-muted pt-1"><custom-checkbox [(checked)]="pony.respawnAtSpawn">always respawn at spawn point</custom-checkbox><custom-checkbox [(checked)]="info.customOutlines">allow custom outlines</custom-checkbox><custom-checkbox [(checked)]="info.freeOutlines" (checkedChange)="freeOutlinesChanged($event)">don't darken outlines</custom-checkbox><custom-checkbox [(checked)]="info.darkenLockedOutlines" [disabled]="!info.freeOutlines" (checkedChange)="darkenLockedOutlinesChanged($event)">darken locked outlines</custom-checkbox></div></div><div class="row form-group" *ngIf="debug"><label class="col-sm-4 col-form-label">Debug options</label><div class="col-sm-8"><button class="btn btn-sm btn-default" (click)="addBlush()">Add blush</button></div></div><div class="row form-group"><label class="col-sm-4 col-form-label">Export/Import options</label><div class="col-sm-8"><button class="btn btn-sm btn-default" (click)="exportPony()">Export pony</button><button class="btn btn-sm btn-default ml-1" (click)="exportPonies()">Export all ponies</button><button class="btn btn-sm btn-default ml-1" (click)="importFile.click()">Import ponies</button><input class="d-none" #importFile type="file" (change)="importPonies(importFile.files[0])"></div></div><div class="row form-group"><label class="col-sm-4 col-form-label" id="social-site-label">Show social site</label><div class="col-sm-8"><div class="dropdown btn-group" dropdown><button class="btn btn-default dropdown-toggle" dropdownToggle aria-labelledby="social-site-label" aria-describedby="social-site-help"><fa-icon class="mr-1" *ngIf="site?.icon" [icon]="icon(site.icon)" [fixedWidth]="true" [style.color]="site.color" size="lg" [attr.aria-label]="site.icon"></fa-icon><strong>{{site?.name}}</strong></button><div class="dropdown-menu" *dropdownMenu><a class="dropdown-item" *ngFor="let s of sites" (click)="site = s"><fa-icon class="mr-1" *ngIf="s.icon" [icon]="icon(s.icon)" [fixedWidth]="true" [style.color]="s.color" size="lg" [attr.aria-label]="s.icon"></fa-icon><strong>{{s.name}}</strong></a></div></div><div class="dropdown btn-group ml-1" dropdown *ngIf="tags.length &gt; 1"><button class="btn btn-default dropdown-toggle" dropdownToggle aria-label="Show tag"><span class="badge" *ngIf="tag.id" [ngClass]="'badge-' + tag.className">{{tag.id}}</span><strong *ngIf="!tag.id">{{tag.name}}</strong></button><div class="dropdown-menu" *dropdownMenu><a class="dropdown-item" *ngFor="let t of tags" (click)="tag = t"><span class="badge" *ngIf="t.id" [ngClass]="'badge-' + t.className">{{t.id}}</span><strong *ngIf="!t.id">{{t.name}}</strong></a></div></div><div class="text-muted mt-1" id="social-site-help">Shows social site next to your name to prove to others that it's your account.</div></div></div><div class="row form-group"><label class="col-sm-4 col-form-label" for="description">Description<fa-icon class="text-muted ml-2" [icon]="infoIcon" [tooltip]="descriptionTooltip" containerClass="tooltip-desc"></fa-icon></label><div class="col-sm-8"><input class="form-control" id="description" [(ngModel)]="pony.desc" placeholder="example: with a hat #oc #winter" [maxlength]="maxDescLength"></div></div><div class="row form-group"><div class="col-sm-4 col-lock-box"><label for="frame-input">Animation</label><check-box class="lock-box" [icon]="playIcon" [(checked)]="playAnimation" label="Play animation"></check-box></div><div class="col-sm-8"><div class="input-group"><input class="form-control" id="frame-input" type="number" [(ngModel)]="state.animationFrame" [disabled]="playAnimation" min="0" title="Animation frame" aria-label="Animation frame"><div class="input-group-append dropdown" *ngIf="canSaveFiles" dropdown><button class="btn btn-default dropdown-toggle" dropdownToggle *ngIf="canExport" aria-label="Export / Import"><fa-icon [icon]="codeIcon"></fa-icon></button><div class="dropdown-menu dropdown-menu-right" *dropdownMenu><a class="dropdown-item" (click)="export()">export all</a><a class="dropdown-item" (click)="import()">import data</a><a class="dropdown-item" (click)="testSize()">print compressed</a><a class="dropdown-item" (click)="testJSON()">print raw</a></div></div><div class="input-group-append dropdown" dropdown><button class="btn btn-default" *ngIf="canSaveFiles" (click)="export(activeAnimation)" title="Save as PNG" aria-label="Save as PNG"><fa-icon [icon]="saveIcon"></fa-icon></button><button class="btn btn-default dropdown-toggle" dropdownToggle style="min-width: 80px"><strong>{{animations[activeAnimation]().name}}</strong></button><div class="dropdown-menu dropdown-menu-right" *dropdownMenu><a class="dropdown-item" *ngFor="let a of animations; let i = index" (click)="setActiveAnimation(i)">{{a().name}}</a></div></div></div></div></div><hr><fill-outline label="Body color" [(fill)]="info.coatFill" [(outline)]="info.coatOutline" [(outlineLocked)]="info.lockCoatOutline" [outlineHidden]="!customOutlines" (change)="changed()"></fill-outline><hr><set-selection label="Horn" [base]="coatFill" [set]="info.horn" [sets]="horns" [compact]="true" (change)="changed()" [darken]="darken"></set-selection><hr><div class="row form-group"><label class="col-sm-4 col-form-label">Magic color</label><div class="col-sm-8"><color-picker [(color)]="info.magicColor" label="Magic color"></color-picker></div></div><hr><set-selection label="Wings" [base]="coatFill" [set]="info.wings" [sets]="wings" [compact]="true" (change)="changed()" [darken]="darken"></set-selection><hr><set-selection label="Ears" [base]="coatFill" [set]="info.ears" [sets]="ears" [compact]="true" (change)="changed()" [darken]="darken"></set-selection><hr><set-selection label="Front hooves" [base]="coatFill" [set]="info.frontHooves" [sets]="frontHooves" [compact]="true" [darken]="darken" (change)="changed()"></set-selection><hr><set-selection label="Back hooves" [base]="hoovesFill" [set]="info.backHooves" [sets]="backHooves" [compact]="true" [darken]="darken" (change)="changed()"></set-selection><hr><butt-mark-editor [info]="info" [state]="buttMarkState"></butt-mark-editor></div></tab><tab title="mane"><div class="character-tab" *tabContent><set-selection label="Mane" [base]="maneFill" [set]="info.mane" [sets]="manes" [nonLockable]="true" [darken]="darken" (change)="changed()"></set-selection><hr><set-selection label="Back mane" [base]="maneFill" [set]="info.backMane" [sets]="backManes" [darken]="darken" (change)="changed()"></set-selection></div></tab><tab title="tail"><div class="character-tab" *tabContent><set-selection label="Tail" [base]="maneFill" [set]="info.tail" [sets]="tails" [darken]="darken" (change)="changed()"></set-selection><div class="form-group text-center"><button class="btn btn-sm btn-default" (click)="copyCoatColorToTail()" [disabled]="info.tail.lockFills[0]">Use body color</button></div></div></tab><tab title="face"><div class="character-tab" *tabContent><div class="row form-group"><div class="col-sm-4 col-lock-box"><label id="eye-color">Eye color</label><check-box class="lock-box" [(checked)]="info.lockEyeColor" [icon]="lockIcon" (checkedChange)="eyeColorLockChanged($event)" label="Lock color for both eyes" title="Lock color for both eyes"></check-box></div><div class="col-sm-8"><color-picker [(color)]="info.eyeColorRight" (colorChange)="changed()" labelledBy="eye-color"></color-picker></div></div><div class="row form-group" *ngIf="!info.lockEyeColor"><label class="col-sm-4 col-form-label" id="eye-color-left">Eye color (left)</label><div class="col-sm-8"><color-picker [(color)]="info.eyeColorLeft" labelledBy="eye-color-left"></color-picker></div></div><div class="row form-group"><div class="col-sm-4 col-lock-box"><label id="eye-whites-label">Eye whites</label><check-box class="lock-box" [(checked)]="lockEyeWhites" [icon]="lockIcon" (checkedChange)="eyeWhiteLockChanged($event)" label="Lock left eye white for both eyes" title="Lock left eye white for both eyes"></check-box></div><div class="col-sm-8"><color-picker [(color)]="info.eyeWhites" (colorChange)="changed()" labelledBy="eye-whites-label"></color-picker></div></div><div class="row form-group" *ngIf="info.unlockEyeWhites"><label class="col-sm-4 col-form-label" id="eye-whites-label-left">Eye whites (left)</label><div class="col-sm-8"><color-picker [(color)]="info.eyeWhitesLeft" labelledBy="eye-whites-label-left"></color-picker></div></div><div class="row form-group"><div class="col-sm-4 col-lock-box"><label id="eyes">{{info.lockEyes ? 'Eyes' : 'Right eye'}}</label><check-box class="lock-box" [(checked)]="info.lockEyes" [icon]="lockIcon" (checkedChange)="eyeOpennessChanged($event)" label="Lock both eyes" title="Lock both eyes"></check-box></div><div class="col-sm-8"><sprite-selection [(selected)]="info.eyeOpennessRight" [sprites]="eyesRight" [fill]="info.eyeColorRight" [circle]="info.coatFill" [reverseExtra]="true" [skip]="1" [limit]="9" [darken]="darken" (selectedChange)="eyeOpennessChanged(info.lockEyes)" aria-labelledby="eyes"></sprite-selection></div></div><div class="row form-group" *ngIf="!info.lockEyes"><div class="col-sm-4"><label id="left-eye">Left eye</label></div><div class="col-sm-8"><sprite-selection [(selected)]="info.eyeOpennessLeft" [sprites]="eyesLeft" [fill]="info.eyeColorLeft" [darken]="darken" [circle]="info.coatFill" [reverseExtra]="true" [skip]="1" [limit]="5" aria-labelledby="left-eye"></sprite-selection></div></div><div class="row form-group"><div class="col-sm-4 col-lock-box"><label>Eyeshadow</label><check-box class="lock-box" [(checked)]="info.eyeshadow" (checkedChange)="characterPreview.blink()" label="Use eye shadow" title="Use eye shadow"></check-box></div><div class="col-sm-8"><color-picker [(color)]="info.eyeshadowColor" [isDisabled]="!info.eyeshadow" label="Eyeshadow color"></color-picker></div></div><div class="row form-group"><label class="col-sm-4 col-form-label" id="eyelashes">Eyelashes</label><div class="col-sm-8"><sprite-selection [(selected)]="info.eyelashes" [sprites]="eyelashes" [fill]="info.eyeColorRight" [darken]="darken" [circle]="info.coatFill" [reverseExtra]="true" aria-labelledby="eyelashes"></sprite-selection></div></div><div class="row form-group"><div class="col-sm-4 col-lock-box"><label id="eyelashes-label">Eyelash color</label><check-box class="lock-box" [(checked)]="lockEyelashColor" [icon]="lockIcon" (checkedChange)="eyelashLockChanged($event)" label="Lock eyelash color for both eyes" title="Lock eyelash color for both eyes"></check-box></div><div class="col-sm-8"><color-picker [(color)]="info.eyelashColor" (colorChange)="changed()" labelledBy="eyelashes-label"></color-picker></div></div><div class="row form-group" *ngIf="!lockEyelashColor"><label class="col-sm-4 col-form-label" id="eyelashes-label-left">Eyelash color (left)</label><div class="col-sm-8"><color-picker [(color)]="info.eyelashColorLeft" labelledBy="eyelashes-label-left"></color-picker></div></div><hr><set-selection label="Muzzle" base="info.coatFill" [set]="info.nose" [sets]="noses" [darken]="darken" [compact]="true" (change)="changed(); updateMuzzles()"></set-selection><hr><set-selection label="Markings" [base]="coatFill" [set]="info.head" [sets]="heads" [darken]="darken" [onlyPatterns]="true" (change)="changed()"></set-selection><hr><div class="row form-group"><label class="col-sm-4 col-form-label" id="fangs">Fangs</label><div class="col-sm-8"><sprite-selection [(selected)]="info.fangs" [sprites]="fangs" [fill]="info.nose.fills" [darken]="darken" [outline]="info.nose.outlines" [circle]="info.coatFill" aria-labelledby="fangs"></sprite-selection></div></div><div class="row form-group"><label class="col-sm-4 col-form-label" id="expression" for="#expression-selection">Expression</label><div class="col-sm-8"><sprite-selection id="expression-selection" [(selected)]="info.muzzle" [sprites]="muzzles" [fill]="info.nose.fills" [darken]="darken" [outline]="info.nose.outlines" [circle]="info.coatFill" [limit]="9" aria-labelledby="expression"></sprite-selection></div></div><hr><set-selection label="Facial hair" [base]="maneFill" [set]="info.facialHair" [sets]="facialHair" [darken]="darken" (change)="changed()"></set-selection></div></tab><tab title="other"><div class="character-tab" *tabContent><tabset class="accessories-tabset" saveActiveTab="character-active-accessory-tab" label="Character accessories"><tab title="head"><div class="accessory-tab" *tabContent><set-selection label="Head accessories" [set]="info.headAccessory" [sets]="headAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection><hr><set-selection label="Ear accessories" [set]="info.earAccessory" [sets]="earAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection><hr><set-selection label="Face accessories" [set]="info.faceAccessory" [sets]="faceAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection></div></tab><tab title="neck"><div class="accessory-tab" *tabContent><set-selection label="Neck accessories" [set]="info.neckAccessory" [sets]="neckAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection></div></tab><tab title="legs"><div class="accessory-tab" *tabContent><div class="row form-group"><label class="col-sm-4 col-form-label">Use the same accessory</label><div class="col-sm-8 text-muted pt-1"><div class="mb-2"><custom-checkbox [(checked)]="info.lockBackLegAccessory">for front and back legs</custom-checkbox></div><div class="mb-2"><custom-checkbox [(checked)]="lockFrontLegAccessory">for both front legs</custom-checkbox></div><div class="mb-2"><custom-checkbox [(checked)]="lockBackLegAccessory" [disabled]="info.lockBackLegAccessory">for both back legs</custom-checkbox></div></div></div><set-selection [label]="info.lockFrontLegAccessories ? 'Front leg accessory' : 'Front leg accessory (left)'" [set]="info.frontLegAccessory" [sets]="frontLegAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection><hr><div *ngIf="info.unlockFrontLegAccessory"><set-selection label="Front leg accessory (right)" [set]="info.frontLegAccessoryRight" [sets]="frontLegAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection><hr></div><div *ngIf="!info.lockBackLegAccessory"><set-selection [label]="info.lockBackLegAccessories ? 'Back leg accessory' : 'Back leg accessory (left)'" [set]="info.backLegAccessory" [sets]="backLegAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection><hr></div><div *ngIf="!info.lockBackLegAccessory &amp;&amp; info.unlockBackLegAccessory"><set-selection label="Back leg accessory (right)" [set]="info.backLegAccessoryRight" [sets]="backLegAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection></div></div></tab><tab title="chest"><div class="accessory-tab" *tabContent><set-selection label="Chest accessories" [set]="info.chestAccessory" [sets]="chestAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection><set-selection *ngIf="hasSleeves(info.chestAccessory.type)" label="Sleeves" [set]="info.sleeveAccessory" [darken]="darken" [sets]="sleeveAccessories" (change)="changed()"></set-selection></div></tab><tab title="back"><div class="accessory-tab" *tabContent><set-selection label="Back accessories" [set]="info.backAccessory" [sets]="backAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection></div></tab><tab title="waist"><div class="accessory-tab" *tabContent><set-selection label="Waist accessories" [set]="info.waistAccessory" [sets]="waistAccessories" [darken]="darken" [nonLockable]="true" (change)="changed()"></set-selection></div></tab><tab title="other"><div class="accessory-tab" *tabContent><div class="form-group d-flex justify-content-center pt-2"><custom-checkbox [(checked)]="previewExtra">show preview</custom-checkbox><em class="text-muted ml-2">(you have to enable these accessories in-game)</em></div><set-selection label="Extra accessories" [set]="info.extraAccessory" [sets]="extraAccessories" [darken]="darken" (change)="changed()"></set-selection></div></tab></tabset></div></tab></tabset></div></div>