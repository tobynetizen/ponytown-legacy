<div class="friends-box dropdown" dropdown autoClose="outsideClick" (isOpenChange)="toggle()" [hookToCanvas]="true" [focusOnOpen]="false" [preventAutoCloseOnOutlet]="true"><button class="game-button dropdown-toggle no-arrow" dropdownToggle (click)="false" title="Friends"><fa-icon [icon]="friendsIcon" [fixedWidth]="true"></fa-icon></button><div class="friends-dropdown-menu dropdown-menu dropdown-menu-right" *dropdownMenu><div class="friends-list-header list-unstyled"><div class="dropdown-header d-flex"><div class="flex-grow-1">Friends</div><div class="dropdown" dropdown><button class="dropdown-toggle no-arrow" dropdownToggle><span class="text-success" *ngIf="!hidden">online</span><span class="text-muted" *ngIf="hidden">offline</span><fa-icon class="ml-2" [icon]="cogIcon"></fa-icon></button><div class="dropdown-menu dropdown-menu-right" *dropdownMenu><button class="dropdown-item" (click)="setStatus('online')"><fa-icon class="mr-2 text-success" [icon]="statusIcon" size="xs" [fixedWidth]="true"></fa-icon>Online</button><button class="dropdown-item" (click)="setStatus('invisible')"><fa-icon class="mr-2 text-muted" [icon]="statusIcon" size="xs" [fixedWidth]="true"></fa-icon>Show as Offline</button></div></div></div></div><div class="friends-list" *ngIf="friends &amp;&amp; friends.length; else noFriends"><div class="friends-item" dropdown *ngFor="let f of friends" [ngClass]="f.online ? 'online' : 'offline'" [useOutlet]="true" [hookToCanvas]="true" [focusOnOpen]="false" [focusOnClose]="false"><button class="d-flex" dropdownToggle><portrait-box class="mr-2" [pony]="f.ponyInfo" size="small" [noBorder]="true"></portrait-box><div class="flex-grow-1 friends-item-details"><div class="friends-item-name">{{f.actualName}}&#160;</div><div class="friends-item-more"><div class="text-success float-right ml-2" *ngIf="f.online">online</div><div class="text-muted float-right ml-2" *ngIf="!f.online">offline</div><div class="text-muted friends-item-account">{{f.accountName}}</div></div></div></button><div class="friends-item-delete d-flex px-2 py-1" *ngIf="removing === f"><button class="btn btn-sm btn-outline-success flex-grow-1" (click)="cancelRemove(); $event.stopPropagation()">Cancel</button><button class="btn btn-sm btn-outline-danger flex-grow-1 ml-2" (click)="confirmRemove(); $event.stopPropagation()">Confirm remove</button></div><div class="options-dropdown-menu dropdown-menu" *dropdownMenu><button class="dropdown-item" (click)="sendMessageTo(f)" [disabled]="!f.online">Send whisper</button><button class="dropdown-item" (click)="inviteToParty(f)" [disabled]="!f.online">Invite to party</button><div class="dropdown-divider"></div><button class="dropdown-item" (click)="remove(f)">Remove</button></div></div></div><ng-template #noFriends><div class="text-center text-muted p-2" *ngIf="friends">select a player and use <fa-icon [icon]="userOptionsIcon"></fa-icon> menu to add them to your friends</div><div class="text-center text-muted p-2" *ngIf="!friends">Loading...</div></ng-template></div></div>