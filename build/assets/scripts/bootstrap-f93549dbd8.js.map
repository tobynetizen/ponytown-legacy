<div class="modal-header d-none d-sm-block d-none-for-low-height"><h4 class="modal-title" labelledBy=".modal">Actions</h4></div><div class="modal-body modal-checkboxes"><tabset class="fixed-height" type="pills" saveActiveTab="testing-save-tab" [destroyOnHide]="false" (activeIndexChange)="tabIndex = $event"><tab title="Actions" [icon]="actionsIcon"><div class="action-columns" *tabContent><div class="d-flex align-items-center mb-2" *ngFor="let a of actions"><action-button class="mb-0 mr-2" [draggableItem]="a" [action]="a" [shadow]="false"></action-button><b>{{a.title}}</b></div></div></tab><tab title="Expressions" [icon]="expressionsIcon"><div *tabContent><div class="d-flex mb-3"><action-button class="mb-0 mr-sm-4" [draggableItem]="emoteAction" [action]="emoteAction" [shadow]="false" (draggableDrop)="drop($event)"></action-button><div class="sub-tabset nav nav-pills mb-0"><button class="btn-unstyled nav-link" [class.active]="activeTab === 'right-eye'" (click)="activeTab = 'right-eye'">Right eye</button><button class="btn-unstyled nav-link" [class.active]="activeTab === 'left-eye'" (click)="activeTab = 'left-eye'">Left eye</button><button class="btn-unstyled nav-link" [class.active]="activeTab === 'mouth'" (click)="activeTab = 'mouth'">Mouth</button><button class="btn-unstyled nav-link" [class.active]="activeTab === 'extra'" (click)="activeTab = 'extra'">Extra</button></div></div><div class="fixed-height-tabset"><div [class.inactive-tab]="activeTab !== 'right-eye'"><sprite-selection [(selected)]="eyeRight" [sprites]="eyesRight" [fill]="eyeColor" [circle]="coatFill" [reverseExtra]="true" [skip]="1" [invisible]="tabIndex !== 1 || activeTab !== 'right-eye'" (selectedChange)="changed(lockEyes)"></sprite-selection></div><div [class.inactive-tab]="activeTab !== 'left-eye'"><custom-checkbox class="mb-2" [(checked)]="lockEyes" (checkedChange)="changed($event)">Use the same as right one</custom-checkbox><sprite-selection [(selected)]="eyeLeft" [sprites]="eyesLeft" [fill]="eyeColor" [disabled]="lockEyes" [circle]="coatFill" [reverseExtra]="true" [skip]="1" [invisible]="tabIndex !== 1 || activeTab !== 'left-eye'" (selectedChange)="changed(lockEyes)"></sprite-selection></div><div [class.inactive-tab]="activeTab !== 'mouth'"><sprite-selection id="expression-selection" [(selected)]="muzzle" [sprites]="muzzles" [fill]="noseFills" [outline]="noseOutlines" [circle]="coatFill" [invisible]="tabIndex !== 1 || activeTab !== 'mouth'" (selectedChange)="changed(lockEyes)"></sprite-selection></div><div [class.inactive-tab]="activeTab !== 'extra'"><sprite-selection class="mb-2" [(selected)]="irisRight" [sprites]="irisesRight" [fill]="eyeColor" [invisible]="tabIndex !== 1 || activeTab !== 'extra'" [circle]="coatFill" [reverseExtra]="true" (selectedChange)="changed(lockEyes)"></sprite-selection><custom-checkbox [(checked)]="lockIrises" (checkedChange)="changed(lockEyes)">Use the same as right one</custom-checkbox><sprite-selection class="mt-2" [(selected)]="irisLeft" [sprites]="irisesLeft" [fill]="eyeColor" [disabled]="lockIrises" [invisible]="tabIndex !== 1 || activeTab !== 'extra'" [circle]="coatFill" [reverseExtra]="true" (selectedChange)="changed(lockEyes)"></sprite-selection><div class="d-flex flex-wrap mt-3"><label class="text-muted mr-3">Other options</label><custom-checkbox [(checked)]="blush" (checkedChange)="changed(lockEyes)">Blush</custom-checkbox><custom-checkbox class="ml-4" [(checked)]="sleeping" (checkedChange)="changed(lockEyes)">Sleeping</custom-checkbox><custom-checkbox class="ml-4" [(checked)]="tears" (checkedChange)="changed(lockEyes)">Tears</custom-checkbox><custom-checkbox class="ml-4" [(checked)]="crying" (checkedChange)="changed(lockEyes)">Crying</custom-checkbox><custom-checkbox class="ml-4" [(checked)]="hearts" (checkedChange)="changed(lockEyes)">Hearts</custom-checkbox></div></div></div></div></tab><tab title="Chat" [icon]="chatIcon"><div class="action-columns" *tabContent><div class="d-flex align-items-center mb-2" *ngFor="let a of commands"><action-button class="mb-0 mr-2" [draggableItem]="a" [action]="a" [shadow]="false"></action-button><b>{{a.title}}</b></div></div></tab><tab title="Options" [icon]="optionsIcon"><div *tabContent><button class="btn btn-outline-secondary mr-2 mb-2" (click)="resetToDefault()">Reset to default actions</button><button class="btn btn-outline-secondary mr-2 mb-2" (click)="clearActionBar()">Clear action bar</button><button class="btn btn-outline-secondary mr-2 mb-2" (click)="undo()">Undo</button><button class="btn btn-outline-secondary mr-2 mb-2" (click)="export()">Export actions</button><button class="btn btn-outline-secondary mr-2 mb-2" (click)="importFile.click()">Import actions</button><input class="d-none" #importFile type="file" (change)="import(importFile.files[0])"></div></tab><tab *ngIf="dev" title="Dev" [icon]="devIcon"><div *tabContent><div class="d-flex mb-3"><action-button class="mb-0 mr-4" [draggableItem]="entityAction" [action]="entityAction" [shadow]="false" (draggableDrop)="drop($event)"></action-button><input class="form-control" placeholder="entity name" [(ngModel)]="entityName" (ngModelChange)="updateEntity()" style="max-width: 200px;"></div><div class="d-flex flex-wrap" style="height: 250px; overflow-y: scroll"><action-button *ngFor="let a of entityActions" [draggableItem]="a" [action]="a"></action-button></div></div></tab></tabset></div><div class="modal-footer d-flex"><div class="flex-grow-1"><em class="text-muted">Drag actions to the action bar</em></div><button class="btn btn-outline-secondary" (click)="ok()">Close</button></div>