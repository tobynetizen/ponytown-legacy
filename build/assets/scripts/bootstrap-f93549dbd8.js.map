<div *ngIf="compact &amp;&amp; !onlyPatterns"><div class="row form-group"><label class="col-sm-4 col-form-label">{{label}}</label><div class="col-sm-8"><sprite-selection [(selected)]="set.type" [sprites]="sprites" [fill]="set.fills" [outline]="set.outlines" [darken]="darken" (selectedChange)="onChange()" [circle]="circle" [attr.aria-label]="'Select ' + label" emptyLabel="No {{label}}"></sprite-selection></div></div></div><div *ngIf="!compact &amp;&amp; !onlyPatterns"><div class="row form-group"><label class="col-sm-12 text-center col-form-label text-muted">{{label}}</label></div><div class="row form-group"><div class="col-sm-12"><sprite-selection [(selected)]="set.type" [sprites]="sprites" [fill]="set.fills" [outline]="set.outlines" [darken]="darken" (selectedChange)="onChange()" [circle]="circle" [attr.aria-label]="'Select ' + label" emptyLabel="No {{label}}"></sprite-selection></div></div></div><div *ngIf="showColorPatterns &amp;&amp; !onlyPatterns"><div class="row form-group"><label class="col-sm-12 text-center col-form-label text-muted">Color pattern</label></div><div class="row form-group"><div class="col-sm-12"><sprite-selection [(selected)]="set.pattern" [sprites]="sets[set.type]" [fill]="exampleFills" [outline]="exampleOutlines" (selectedChange)="onChange()" aria-label="Select color pattern" [darken]="darken"></sprite-selection></div></div></div><div *ngIf="onlyPatterns"><div class="row form-group"><label class="col-sm-4 col-form-label">{{label}}</label><div class="col-sm-8"><sprite-selection [(selected)]="set.pattern" [sprites]="sets[set.type]" [fill]="exampleFills" [outline]="exampleOutlines" (selectedChange)="onChange()" aria-label="Select color pattern" [darken]="darken"></sprite-selection></div></div></div><div *ngFor="let c of exampleFills; let i = index"><fill-outline *ngIf="patternColors &gt; i" label="Color {{i + 1}}" [base]="i === 0 ? base : set.fills[0]" [nonLockable]="i === 0 &amp;&amp; nonLockable" [outlineHidden]="isOutlineHidden" [indicatorColor]="showColorPatterns ? c : ''" [(fill)]="set.fills[i]" [(locked)]="set.lockFills[i]" [(outline)]="set.outlines[i]" [(outlineLocked)]="set.lockOutlines[i]" (change)="onChange()"></fill-outline></div>