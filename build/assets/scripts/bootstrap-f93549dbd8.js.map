<ng-template #settingsModal><settings-modal (close)="modalRef.hide()" [focusTrap]="true" (keydown)="$event.stopPropagation()"></settings-modal></ng-template><ng-template #invitesModal><invites-modal (close)="modalRef.hide()" [focusTrap]="true" (keydown)="$event.stopPropagation()"></invites-modal></ng-template><ng-template #actionsModal><actions-modal (close)="modalRef.hide()" [focusTrap]="true" (keydown)="$event.stopPropagation()"></actions-modal></ng-template><div class="settings-box unselectable"><div class="dropdown" #dropdown="ag-dropdown" dropdown autoClose="outsideClick" [hookToCanvas]="true"><button class="game-button dropdown-toggle no-arrow" dropdownToggle (click)="false" title="Settings"><fa-icon [icon]="cogIcon" [fixedWidth]="true"></fa-icon></button><div class="dropdown-menu dropdown-menu-right settings-box-menu" *dropdownMenu><div class="dropdown-header d-flex justify-content-between"><span>{{server}}</span><span class="clock-display">{{time}}</span></div><div class="dropdown-item d-flex"><fa-icon class="mr-2" [icon]="searchIcon" [fixedWidth]="true"></fa-icon><div class="flex-grow-1">Scale (x{{scale}})</div><button class="btn btn-xs btn-outline-secondary" (click)="zoomOut()" aria-label="Zoom out"><fa-icon [icon]="minusIcon" [fixedWidth]="true"></fa-icon></button><button class="btn btn-xs btn-outline-secondary ml-2" (click)="zoomIn()" aria-label="Zoom in"><fa-icon [icon]="plusIcon" [fixedWidth]="true"></fa-icon></button></div><div class="dropdown-item dropdown-item-static"><a (click)="toggleVolume()" title="Toggle sound"><fa-icon [icon]="volumeIcon" [fixedWidth]="true"></fa-icon></a><slider-bar [(value)]="volume" [step]="1" (started)="volumeStarted()"></slider-bar><div class="text-muted text-right" *ngIf="track" style="margin-top: -5px;"><small>playing: <b>{{track}}</b><a class="text-muted ml-1" (click)="nextTrack()" title="Next track"><fa-icon [icon]="forwardIcon" [fixedWidth]="true"></fa-icon></a></small></div></div><a class="dropdown-item" (click)="unhideAllHiddenPlayers()"><fa-icon class="mr-2" [icon]="emptyIcon" [fixedWidth]="true"></fa-icon>Unhide players (temporary)</a><a class="dropdown-item" (click)="openSettings()"><fa-icon class="mr-2" [icon]="emptyIcon" [fixedWidth]="true"></fa-icon>Settings</a><a class="dropdown-item" (click)="openActions()"><fa-icon class="mr-2" [icon]="emptyIcon" [fixedWidth]="true"></fa-icon>Actions</a><div class="dropdown-divider"></div><a class="dropdown-item" (click)="leave()"><fa-icon class="mr-2" [icon]="signOutIcon" [fixedWidth]="true"></fa-icon>Leave</a></div></div></div>