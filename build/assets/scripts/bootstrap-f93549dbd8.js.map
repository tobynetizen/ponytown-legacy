<div class="chat-box" #chatBox><div #chatBoxInput><input class="chat-input" id="chat-input" #inputElement [(ngModel)]="message" (keydown)="keydown($event)" [maxlength]="maxSayLength" aria-label="Chat message"><div class="chat-box-type" #typeBox (click)="toggleChatType()"><span #typePrefix></span>[<span class="chat-box-type-name" #typeName></span>]:</div><button class="game-button chat-send-button" (click)="send($event)" title="Send message" aria-label="Send message"><fa-icon [icon]="sendIcon"></fa-icon></button></div></div><button class="game-button chat-open-button" (click)="toggle()" (mousedown)="$event.preventDefault()" [disabled]="disabled" title="Toggle chat" aria-label="Toggle message"><fa-icon [icon]="commentIcon" [fixedWidth]="true"></fa-icon></button>