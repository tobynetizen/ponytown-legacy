<button class="action-button" (click)="click()" [class.active]="active" [class.no-shadow]="!shadow" [title]="action &amp;&amp; action.title || ''"><canvas #canvas width="29" height="29"></canvas><div class="shortcut">{{shortcut}}</div><div class="count" *ngIf="action &amp;&amp; action.type === 'item'">{{action.count}}</div><div class="cover"></div></button>