<ng-template #notePopover><textarea class="form-control pony-mod-note-editor" cols="20" rows="8" agAutoFocus [(ngModel)]="note" (keydown.escape)="blur()" (blur)="blur()"></textarea></ng-template><ng-template #tooltip><div class="text-left text-pre"><div *ngIf="hasCounters"><span class="text-muted">spam:</span><span class="ml-1">{{counters?.spam || 0}}</span><span class="text-muted ml-1">swearing:</span><span class="ml-1">{{counters?.swears || 0}}</span><span class="text-muted ml-1">timeouts:</span><span class="ml-1">{{counters?.timeouts || 0}}</span></div><div>{{note}}</div></div></ng-template><div class="btn-group btn-group-xs btn-group-shadow" *ngIf="check?.hgf?.bvc?.wer?.ngf"><div class="btn-group dropdown" dropdown><button class="btn btn-xs btn-default" dropdownToggle><fa-icon [icon]="moreIcon"></fa-icon></button><div class="dropdown-menu" *dropdownMenu><a class="dropdown-item" (click)="report()"><fa-icon class="mr-1" [icon]="flagIcon" [fixedWidth]="true"></fa-icon>Report</a><h6 class="dropdown-header">Other options</h6><a class="dropdown-item" *ngFor="let a of check.actions" (click)="modAction(a.action)"><fa-icon class="mr-1 text-danger" [icon]="dangerIcon" [fixedWidth]="true"></fa-icon>{{a.name}}</a></div></div><div class="btn-group" [tooltip]="isNoteOpen ? null : tooltip" [isDisabled]="!note &amp;&amp; !hasCounters" placement="bottom" containerClass="tooltip-notes"><button class="btn btn-xs" [popover]="notePopover" placement="bottom" [isOpen]="isNoteOpen" [btnHighlightDanger]="!!note" [class.pointer-none]="isNoteOpen" (onShown)="isNoteOpen = true" (onHidden)="blur()" container="body"><fa-icon [icon]="noteIcon"></fa-icon></button></div><div class="btn-group dropdown" dropdown [tooltip]="muteTooltip"><button class="btn btn-xs" dropdownToggle [ngClass]="className(mute)"><fa-icon [icon]="muteIcon"></fa-icon></button><div class="dropdown-menu dropdown-menu-right" *dropdownMenu><a class="dropdown-item" (click)="setMute(0)">clear <b>mute</b></a><a class="dropdown-item" (click)="setMute(-1)">perma <b>mute</b></a><div class="dropdown-divider"></div><a class="dropdown-item" *ngFor="let t of timeouts" (click)="setMute(t.value)">{{t.label}}</a></div></div><div class="btn-group dropdown" dropdown [tooltip]="shadowTooltip"><button class="btn btn-xs" dropdownToggle [ngClass]="className(shadow)"><fa-icon [icon]="hideIcon"></fa-icon></button><div class="dropdown-menu dropdown-menu-right" *dropdownMenu><a class="dropdown-item" (click)="setShadow(0)">clear <b>shadow</b></a><a class="dropdown-item" (click)="setShadow(-1)">perma <b>shadow</b></a><div class="dropdown-divider"></div><a class="dropdown-item" *ngFor="let t of timeouts" (click)="setShadow(t.value)">{{t.label}}</a></div></div></div><div class="pony-mod-age" [title]="ageTitle">{{ageLabel}}</div><div class="pony-mod-account" *ngIf="account">{{account}}<span class="text-smuted ml-1">[{{country || '??'}}]</span></div>