<div class="modal-header d-none d-sm-block"><h4 class="modal-title" labelledBy=".modal">Invites</h4></div><div class="modal-body"><p>Using <b>{{invites.length}}</b> out of <b>{{inviteLimit}}</b> invites.</p><div class="list-group"><div class="list-group-item" *ngFor="let i of invites" [class.text-muted]="!i.active"><div class="d-flex justify-content-between"><div class="d-flex align-items-center"><portrait-box [pony]="i.pony" size="small" [noBorder]="true" style="margin: -5px 10px -5px -10px;"></portrait-box><b>{{i.name}}</b><span class="text-muted ml-1" *ngIf="!i.active">(inactive)</span></div><button class="btn btn-xs btn-outline-danger">Cancel</button></div></div></div><div class="alert alert-danger mt-3 mb-0" *ngIf="error">{{error}}</div></div><div class="modal-footer justify-content-end"><button class="btn btn-outline-secondary" (click)="close.emit()">Close</button></div>