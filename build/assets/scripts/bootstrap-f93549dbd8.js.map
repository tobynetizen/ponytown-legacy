<div class="dropdown" #dropdown="ag-dropdown" dropdown (isOpenChange)="toggleSwapDropdown()" [hookToCanvas]="true" style="padding-bottom: 5px"><button class="game-button dropdown-toggle no-arrow" dropdownToggle title="Swap"><fa-icon [icon]="swapIcon" [fixedWidth]="true"></fa-icon><fa-icon class="timer-icon" [icon]="timerIcon" [style.display]="timeout ? 'block' : 'none'"></fa-icon></button><div class="dropdown-menu dropdown-menu-right" *dropdownMenu><portrait-box [hidden]="!previewInfo" [pony]="previewInfo" size="medium" style="position: absolute; top: 5px; left: -80px;"></portrait-box><character-list (selectCharacter)="swapPony($event)" (close)="dropdown.close()" (previewCharacter)="preview($event)" [inGame]="true"></character-list></div></div>