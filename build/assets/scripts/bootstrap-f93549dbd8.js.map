<div class="chat-log" #chatLog><div class="d-flex chat-log-buttons"><div class="flex-grow-1 d-flex flex-column-reverse"><button class="game-button mb-2" (click)="scrollToEnd()" title="Scroll to end"><fa-icon [icon]="toBottomIcon" [fixedWidth]="true"></fa-icon></button></div></div><div class="chat-log-content" #content><fa-icon class="resize-icon" [icon]="resizeIcon"></fa-icon><div class="chat-log-tabs"><a class="link-plain chat-log-tab" #localTab tabindex (click)="switchTab('local')">Local</a><a class="link-plain chat-log-tab" #partyTab tabindex (click)="switchTab('party')">Party</a><a class="link-plain chat-log-tab" #whisperTab tabindex (click)="switchTab('whisper')">Whisper</a></div><div class="chat-log-scroll-outer"><div class="chat-log-scroll-inner" #scroll><div class="chat-log-scroll-inner-inner" #lines></div></div></div><div class="chat-log-resize-top" (agDrag)="drag($event, true, false)"></div><div class="chat-log-resize-right" (agDrag)="drag($event, false, true)"></div><div class="chat-log-resize-top-right" (agDrag)="drag($event, true, true)"></div></div></div><button class="game-button chat-log-toggle" #toggleButton (click)="toggle()" title="Toggle chatlog"><svg class="fa-icon svg-inline--fa fa-comments fa-w-18 fa-fw" aria-hidden="true" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path class="main-bubble" fill="currentColor" d="M416 192c0-88.4-93.1-160-208-160S0 103.6 0 192c0 34.3 14.1 65.9 38 92-13.4 30.2-35.5 54.2-35.8 54.5-2.2 2.3-2.8 5.7-1.5 8.7S4.8 352 8 352c36.6 0 66.9-12.3 88.7-25 32.2 15.7 70.3 25 111.3 25 114.9 0 208-71.6 208-160z"></path><path fill="currentColor" d="M538 412c23.9-26 38-57.7 38-92 0-66.9-53.5-124.2-129.3-148.1.9 6.6 1.3 13.3 1.3 20.1 0 105.9-107.7 192-240 192-10.8 0-21.3-.8-31.7-1.9C207.8 439.6 281.8 480 368 480c41 0 79.1-9.2 111.3-25 21.8 12.7 52.1 25 88.7 25 3.2 0 6.1-1.9 7.3-4.8 1.3-2.9.7-6.3-1.5-8.7-.3-.3-22.4-24.2-35.8-54.5z"></path></svg><div class="whispers-count" #count></div></button>