<ng-template #popover><div class="notification-popover"><p [innerHTML]="notification.message"></p><div class="small text-muted mb-1" *ngIf="notification.note">{{notification.note}}</div></div><div><button class="btn btn-xs btn-outline-danger float-right" *ngIf="ignoreButton" (click)="ignore()" tooltip="Ignore this player"><fa-icon [icon]="banIcon"></fa-icon></button><div class="notification-buttons"><button class="btn btn-xs btn-success" *ngIf="okButton" (click)="accept()">ok</button><button class="btn btn-xs btn-success" *ngIf="yesButton" (click)="accept()">yes</button><button class="btn btn-xs btn-success" *ngIf="acceptButton" (click)="accept()">accept</button><button class="btn btn-xs btn-danger" *ngIf="noButton" (click)="reject()">no</button><button class="btn btn-xs btn-danger" *ngIf="rejectButton" (click)="reject()">reject</button></div></div></ng-template><div class="notification cursor-pointer" [popover]="popover" [isOpen]="isOpen" (contextmenu)="reject(); $event.preventDefault()" placement="left" containerClass="popover-notification"><portrait-box [pony]="paletteInfo" [flip]="true" size="small"></portrait-box></div>