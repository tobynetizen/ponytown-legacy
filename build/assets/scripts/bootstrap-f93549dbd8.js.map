<div class="party-box" [class.pending]="member.pending" [class.offline]="member.offline" (window:resize)="true"><portrait-box class="cursor-pointer" [pony]="paletteInfo" size="small" (click)="click()"></portrait-box><div class="party-box-icon party-box-leader pointer-none" *ngIf="member.leader" title="Party leader"><fa-icon [icon]="leaderIcon" size="xs"></fa-icon></div><div class="party-box-icon party-box-offline pointer-none" *ngIf="member.offline" title="Offline"><fa-icon [icon]="offlineIcon" size="sm"></fa-icon></div></div>