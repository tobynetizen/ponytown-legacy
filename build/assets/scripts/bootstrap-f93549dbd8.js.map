<div class="row form-group" *ngIf="outlineHidden"><div class="col-4 col-lock-box"><label class="text-muted color-label">{{label}}</label><check-box class="lock-box" *ngIf="hasLock &amp;&amp; !nonLockable" [(checked)]="locked" (checkedChange)="onLockedChange($event)" [icon]="lockIcon" label="Automatic color"></check-box></div><div class="col-8"><color-picker [(color)]="fill" (colorChange)="onFillChange($event)" [isDisabled]="locked" [label]="label || 'Color'" [indicatorColor]="indicatorColor"></color-picker></div></div><div class="row form-group" *ngIf="!outlineHidden"><div class="col-4 col-sm-3 col-lock-box"><label class="text-muted color-label">{{label}}</label><check-box class="lock-box" *ngIf="hasLock &amp;&amp; !nonLockable" [(checked)]="locked" (checkedChange)="onLockedChange($event)" [icon]="lockIcon" label="Automatic color"></check-box></div><div class="col-8 col-sm-4"><color-picker [(color)]="fill" (colorChange)="onFillChange($event)" [isDisabled]="locked" [label]="label + ' fill'" [indicatorColor]="indicatorColor"></color-picker></div><div class="col-4 col-sm-1 col-outline"><check-box class="lock-box" [(checked)]="outlineLocked" (checkedChange)="onOutlineLockedChange($event)" [icon]="lockIcon" label="Automatic outline"></check-box></div><div class="col-8 col-sm-4 col-outline"><color-picker [(color)]="outline" (colorChange)="onOutlineChange($event)" [isDisabled]="outlineLocked" [label]="label + ' outline'" [indicatorColor]="indicatorColor"></color-picker></div></div>