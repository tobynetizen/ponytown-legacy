<div class="pony-box" *ngIf="pony"><div class="pony-box-tags"><div class="pony-box-tag" *ngIf="special" [ngClass]="specialClass">{{special}}</div><div class="pony-box-tag tag-friend" *ngIf="isFriend(pony)">friend</div></div><div class="pony-box-rect"><div class="pony-box-name">{{pony.name}}</div><div class="pony-box-buttons"><site-info [site]="pony.site"></site-info></div><div class="pony-box-buttons-box"><div class="btn-group btn-group-shadow dropdown" dropdown (isOpenChange)="removingFriend = false"><button class="btn btn-xs dropdown-toggle" dropdownToggle [ngClass]="ignoredOrHidden ? 'btn-danger' : 'btn-default'"><fa-icon [icon]="cogIcon"></fa-icon></button><div class="dropdown-menu" *dropdownMenu><button class="dropdown-item" (click)="toggleIgnore()"><fa-icon class="mr-2" [icon]="ignoreIcon" [fixedWidth]="true"></fa-icon>{{isIgnored(pony) ? 'Unignore player' : 'Ignore player'}}<fa-icon class="ml-1" *ngIf="isIgnored(pony)" [icon]="checkIcon"></fa-icon></button><button class="dropdown-item" (click)="hidePlayer(1)"><fa-icon class="mr-2" [icon]="hideIcon" [fixedWidth]="true"></fa-icon>Hide player <span class="text-muted">(24 hours)</span></button><button class="dropdown-item" (click)="hidePlayer(0)"><fa-icon class="mr-2" [icon]="hideIcon" [fixedWidth]="true"></fa-icon>Hide player <span class="text-muted">(permanent)</span></button><div class="dropdown-divider"></div><button class="dropdown-item" (click)="sendMessageTo()"><fa-icon class="mr-2" [icon]="messageIcon" [fixedWidth]="true"></fa-icon>Send whisper</button><button class="dropdown-item" *ngIf="!isFriend(pony)" (click)="addFriend()"><fa-icon class="mr-2 text-success" [icon]="addFriendIcon" [fixedWidth]="true"></fa-icon>Send friend request</button><div *ngIf="isFriend(pony)" style="position: relative;"><button class="dropdown-item" (click)="removingFriend = true; $event.stopPropagation()"><fa-icon class="mr-2 text-danger" [icon]="removeFriendIcon" [fixedWidth]="true"></fa-icon>Remove from friends</button><div class="remove-confirmation px-2 d-flex justify-content-center" *ngIf="removingFriend"><button class="btn btn-sm btn-outline-success flex-grow-1" (click)="removingFriend = false; $event.stopPropagation()">Cancel</button><button class="btn btn-sm btn-outline-danger flex-grow-1 ml-1" (click)="removeFriend()">Confirm remove</button></div></div><div *ngIf="canInviteToSupporterServers"><h6 class="dropdown-header">Supporter options</h6><button class="dropdown-item" (click)="inviteToSupporterServers()"><fa-icon class="mr-2 text-success" [icon]="starIcon" [fixedWidth]="true"></fa-icon>Invite to supporter servers<fa-icon class="ml-1" *ngIf="isInvitedToSupporterServers" [icon]="checkIcon"></fa-icon></button></div></div></div><div class="btn-group btn-group-shadow" *ngIf="canInviteToParty || canRemoveFromParty || canPromoteToLeader"><button class="btn btn-xs btn-default" *ngIf="canInviteToParty" (click)="inviteToParty()" tooltip="Invite to party"><fa-icon [icon]="inviteIcon"></fa-icon></button><button class="btn btn-xs btn-default" *ngIf="canRemoveFromParty" (click)="removeFromParty()" tooltip="Remove from party"><fa-icon [icon]="removeIcon"></fa-icon></button><button class="btn btn-xs btn-default" *ngIf="canPromoteToLeader" (click)="promoteToLeader()" tooltip="Promote to leader"><fa-icon [icon]="leaderIcon"></fa-icon></button></div><mod-box *ngIf="isMod" [pony]="pony"></mod-box></div></div><portrait-box class="pony-box-avatar" [pony]="paletteInfo"></portrait-box></div>