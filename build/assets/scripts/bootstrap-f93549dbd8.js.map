<div class="color-picker dropdown" [class.disabled]="isDisabled" [class.open]="isOpen" [class.show]="isOpen"><div class="color-picker-box" [style.background-color]="bg"></div><input class="form-control color-picker-input" #input type="text" spellcheck="false" (focus)="focus($event)" (blur)="close()" (input)="inputChanged(input.value)" [value]="inputColor" [disabled]="isDisabled" [attr.aria-labelledby]="labelledBy" [attr.aria-label]="label"><a class="color-picker-chevron" (mousedown)="toggleOpen()" [hidden]="isDisabled" aria-label="Pick color"><fa-icon [icon]="chevronIcon" [fixedWidth]="true"></fa-icon></a><div class="dropdown-menu dropdown-menu-right color-picker-menu show" (mousedown)="stopEvent($event)" *ngIf="isOpen" aria-hidden="true"><div class="color-picker-sv" [style.background-color]="hue" (agDrag)="dragSV($event)" agDragRelative="self" [agDragPrevent]="true"><div class="color-picker-sv-overlay"></div><div class="color-wheel-circle-sv" [style.left.%]="svLeft" [style.top.%]="svTop"></div></div><div class="color-picker-hue" (agDrag)="dragHue($event)" agDragRelative="self" [agDragPrevent]="true"><div class="color-wheel-circle-hue" [style.top.%]="hueTop"></div></div></div></div>