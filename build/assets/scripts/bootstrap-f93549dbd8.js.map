<div class="d-flex"><select class="form-control w-50" placeholder="Day" [(ngModel)]="day" (ngModelChange)="change()"><option disabled [ngValue]="0">Day</option><option *ngFor="let d of days" [ngValue]="d">{{d}}</option></select><select class="form-control ml-2" placeholder="Month" [(ngModel)]="month" (ngModelChange)="change()"><option disabled [ngValue]="0">Month</option><option *ngFor="let m of months; let i = index" [ngValue]="i + 1">{{m}}</option></select><select class="form-control ml-2 w-50" placeholder="Year" [(ngModel)]="year" (ngModelChange)="change()"><option disabled [ngValue]="0">Year</option><option *ngFor="let y of years" [ngValue]="y">{{y}}</option></select></div>