<div class="notification-list"><div class="game-button notification-ellipsis" *ngIf="start" (click)="prev()"><fa-icon [icon]="ellipsisIcon"></fa-icon></div><notification-item *ngFor="let n of notifications | slice:start:limit" [notification]="n" [class.elastic-from-right]="n.fresh"></notification-item><div class="game-button notification-ellipsis" *ngIf="hasMore" (click)="next()"><fa-icon [icon]="ellipsisIcon"></fa-icon></div></div>