<div class="form-group text-center"><label class="text-muted" id="butt-mark-label">Butt mark</label></div><div class="row form-group" role="group" aria-labelledby="butt-mark-label"><div class="col-sm-7 mb-1"><button class="btn btn-primary" (click)="clearCM()" title="Clear all"><fa-icon [icon]="trashIcon" [fixedWidth]="true"></fa-icon></button><div class="btn-group ml-1" btnRadioGroup [(ngModel)]="state.brushType"><button class="btn btn-primary" btnRadio="eraser" title="Eraser"><fa-icon [icon]="eraserIcon" [fixedWidth]="true"></fa-icon></button><button class="btn btn-primary" btnRadio="eyedropper" title="Eyedropper"><fa-icon [icon]="eyeDropperIcon" [fixedWidth]="true"></fa-icon></button><button class="btn btn-primary" btnRadio="brush" title="Brush"><fa-icon [icon]="paintBrushIcon" [fixedWidth]="true"></fa-icon></button></div></div><div class="col-sm-5 mb-1"><color-picker [(color)]="state.brush" label="Brush color"></color-picker></div></div><div class="form-group text-center"><bitmap-box [bitmap]="info.cm" [tool]="state.brushType" [(color)]="state.brush" [width]="cmSize" [height]="cmSize"></bitmap-box></div><div class="form-group d-flex justify-content-center align-items-center text-muted"><custom-checkbox [(checked)]="info.cmFlip">don't flip mark on the right side</custom-checkbox></div>