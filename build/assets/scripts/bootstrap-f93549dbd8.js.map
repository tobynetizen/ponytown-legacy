<div class="party-list unselectable" *ngIf="hasParty"><div class="dropdown" dropdown [hookToCanvas]="true"><a class="game-button party-list-options" dropdownToggle><fa-icon *ngIf="!isLeader" [icon]="cogIcon" [fixedWidth]="true" title="Party options"></fa-icon><fa-icon *ngIf="isLeader" [icon]="leaderIcon" [fixedWidth]="true" title="You are party leader"></fa-icon></a><div class="dropdown-menu" *dropdownMenu><div class="dropdown-header" *ngIf="isLeader">You are party leader</div><a class="dropdown-item" (click)="leave()">Leave party</a><a class="dropdown-item" (click)="hidden = !hidden">{{hidden ? 'Show party' : 'Hide party'}}</a></div></div><div class="party-list-items pt-1" *ngIf="!hidden"><div class="game-button party-list-ellipsis mb-1" *ngIf="start" (click)="prev()"><fa-icon [icon]="ellipsisIcon"></fa-icon></div><div *ngFor="let m of members | slice:start:limit"><party-box [member]="m"></party-box></div><div class="game-button party-list-ellipsis" *ngIf="hasMore" (click)="next()" style="margin-top: -5px"><fa-icon [icon]="ellipsisIcon"></fa-icon></div></div></div>