<div class="d-flex"><button class="game-button px-2" (click)="toggleEditor()"><fa-icon [icon]="editIcon"></fa-icon></button><div class="d-flex align-items-start pl-2 pt-1" *ngIf="hasEditor"><div class="dropdown-menu p-0" *ngIf="hasSelectedEntities" style="display: block; width: 500px; position: absolute; top: 36px; left: 0;"><div class="px-2"><div><div class="row form-group mb-2"><label class="col-12 col-form-label"><div class="float-right"><button class="btn btn-xs btn-dark ml-1" (click)="showEntitiesInfo()" title="Show info">info</button><button class="btn btn-xs btn-danger ml-1" (click)="deleteEntities()" title="Delete entities"><fa-icon [icon]="deleteIcon"></fa-icon></button></div>{{entityName}}</label></div></div><div *ngIf="singleEntity"><div class="row form-group mb-2"><label class="col-4 col-form-label">position</label><label class="col-1 col-form-label">x</label><div class="col-3"><input class="form-control" [(ngModel)]="entityX" type="number"></div><label class="col-1 col-form-label">y</label><div class="col-3"><input class="form-control" [(ngModel)]="entityY" type="number"></div></div></div><div *ngIf="isLightEntity"><div class="row form-group mb-2"><label class="col-5 col-form-label">light color</label><div class="col-7"><color-picker [(color)]="entityLightColor"></color-picker></div></div><div class="row form-group mb-2"><label class="col-5 col-form-label">light scale ({{entityLightScale | number:'0.1-1'}})</label><div class="col-7 py-2"><slider-bar [(value)]="entityLightScale" [min]="0" [max]="3"></slider-bar></div></div></div><div *ngIf="isLightSpriteEntity"><div class="row form-group mb-2"><label class="col-5 col-form-label">light sprite color</label><div class="col-7"><color-picker [(color)]="entityLightSpriteColor"></color-picker></div></div><div class="row form-group mb-2"><label class="col-4 col-form-label">light sprite</label><label class="col-1 col-form-label">x</label><div class="col-3"><input class="form-control" [(ngModel)]="entityLightSpriteX" type="number"></div><label class="col-1 col-form-label">y</label><div class="col-3"><input class="form-control" [(ngModel)]="entityLightSpriteY" type="number"></div></div></div></div></div><div class="input-group input-group-sm"><input class="form-control" [(ngModel)]="editorEntity" placeholder="entity"><div class="input-group-append" dropdown><button class="btn btn-default dropdown-toggle" dropdownToggle></button><div class="dropdown-menu" *dropdownMenu style="max-height: 90vh; column-width: 100px; font-size: 10px;"><a class="dropdown-item" *ngFor="let e of editorEntities" (click)="editorEntity = e">{{e}}</a></div></div></div><div class="dropdown ml-1" dropdown><button class="btn btn-sm btn-default dropdown-toggle" dropdownToggle><fa-icon [icon]="cogIcon"></fa-icon></button><div class="dropdown-menu" *dropdownMenu><a class="dropdown-item" (click)="clearLocalStorage()">Clear local storage</a><a class="dropdown-item" (click)="editorClear()" title="Remove all placed entities">Clear all entities</a><a class="dropdown-item" (click)="listEntities()" title="List all placed entities in console">List entities</a><div *ngIf="dev"><h6 class="dropdown-header">Show (numpad 4)</h6><a class="dropdown-item" *ngFor="let field of showFields" (click)="toggleShow(field); $event.stopPropagation()"><fa-icon class="mr-1" [icon]="isShow(field) ? checkIcon : emptyIcon" [fixedWidth]="true"></fa-icon>{{field}}</a></div></div></div><button class="btn btn-sm btn-default ml-1" [btnHighlight]="selectingEntities" (click)="toggleSelecting()" title="Select entities"><fa-icon [icon]="selectIcon"></fa-icon></button><div class="dropdown ml-1" dropdown><button class="btn btn-sm btn-default dropdown-toggle" dropdownToggle>tile: {{tiles[editorTile + 1]}}</button><div class="dropdown-menu" *dropdownMenu><a class="dropdown-item" *ngFor="let t of tiles; let i = index" (click)="editorTile = i - 1">{{t}}</a></div></div><div class="dropdown ml-1" dropdown><button class="btn btn-sm btn-default dropdown-toggle" dropdownToggle>brush: {{editor.brushSize}}</button><div class="dropdown-menu" *dropdownMenu><a class="dropdown-item" (click)="editor.brushSize = 1">1</a><a class="dropdown-item" (click)="editor.brushSize = 2">2</a><a class="dropdown-item" (click)="editor.brushSize = 3">3</a><a class="dropdown-item" (click)="editor.brushSize = 4">4</a><a class="dropdown-item" (click)="editor.brushSize = 5">5</a><a class="dropdown-item" (click)="editor.brushSize = 6">6</a></div></div><div class="dropdown ml-1" dropdown [autoClose]="false"><button class="btn btn-sm btn-default dropdown-toggle" dropdownToggle>global</button><div class="dropdown-menu" *dropdownMenu style="width: 400px"><button style="display: block; width: 0; height: 0;"></button><div class="px-2"><div class="row form-group"><label class="col-5 col-form-label d-flex justify-content-between">light color<custom-checkbox [(checked)]="editor.customLight"></custom-checkbox></label><div class="col-7"><color-picker [(color)]="editor.lightColor" [isDisabled]="!editor.customLight"></color-picker></div></div><div class="row form-group mb-0"><label class="col-5 col-form-label">shadow opacity ({{shadowOpacity}})</label><div class="col-7 py-2"><slider-bar [(value)]="shadowOpacity" [min]="0" [max]="255"></slider-bar></div></div></div></div></div><div class="dropdown ml-1" dropdown><button class="btn btn-sm btn-default dropdown-toggle" dropdownToggle>engine</button><div class="dropdown-menu" *dropdownMenu><a class="dropdown-item" *ngFor="let e of engines" (click)="setEngine(e)" [class.active]="isActiveEngine(e)">{{e.name}}</a></div></div><div class="btn btn-sm btn-default disabled ml-1" *ngIf="hasElevation">elevation: {{editorElevation}}</div><div class="btn btn-sm btn-default disabled ml-1" *ngIf="hasElevation">special: {{editorSpecial}}</div></div></div>